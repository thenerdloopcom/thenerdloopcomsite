# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_new_supabase_service_role_key

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_new_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# --- PayU ---
# Merchant Key provided by PayU
PAYU_MERCHANT_KEY=your_payu_merchant_key

# ⚠️ IMPORTANT: The code expects this variable name to be PAYU_MERCHANT_SALT
# If your dashboard calls it "Secret Key" or "Salt", put the value here.
PAYU_MERCHANT_SALT=your_new_payu_salt_key

# Options: 'test' or 'prod'
PAYU_ENV=test

# --- App URL ---
# Local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (Update this when deploying)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com